{
  "productName": "emergence",
  "version": "0.5.0",
  "identifier": "org.holochain.emergence",
  "build": {
    "beforeBuildCommand": "npm run build -w ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "width": 400,
        "height": 500,
        "decorations": false,
        "resizable": false,
        "center": true,
        "url": "splashscreen.html",
        "label": "splashscreen"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
